# Copy file này thành ".env" (cùng thư mục với platformio.ini) rồi sửa giá trị.
# KHÔNG commit file .env thật lên git — đã có trong .gitignore.
#
# Cách dùng: chỉ cần tạo file .env với nội dung đúng bên dưới rồi bấm
# Upload bình thường (CLI "pio run -t upload" hoặc nút Upload trong VS Code
# PlatformIO extension) — load_env.py tự đọc file này, KHÔNG cần export
# biến môi trường ở terminal nào cả.

AP_SSID=Free WiFi
ADMIN_USER=admin
ADMIN_PASS=doi-mat-khau-nay-ngay
